# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=authentix
POSTGRES_USER=authentix
POSTGRES_PASSWORD=changeme_strong_password

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_char_hex_secret
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AES_KEY=replace_with_64_char_hex_key_for_aes256

# ─── MinIO (S3-compatible storage) ────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_strong_minio_password
MINIO_BUCKET=authentix-evidence

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Blockchain Mode ──────────────────────────────────────────────────────────
# Options: mock | fabric
BLOCKCHAIN_MODE=mock
# Only required when BLOCKCHAIN_MODE=fabric:
FABRIC_GATEWAY_ENDPOINT=localhost:7051
FABRIC_CHANNEL=authentix-channel
FABRIC_CHAINCODE=authentix-ledger
FABRIC_MSP_ID=Org1MSP
FABRIC_CERT_PATH=./fabric-certs/admin.crt
FABRIC_KEY_PATH=./fabric-certs/admin.key
FABRIC_TLS_CERT_PATH=./fabric-certs/tls-ca.crt

# ─── Seeded Admin ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123!
ADMIN_EMAIL=admin@authentix.gov.in
